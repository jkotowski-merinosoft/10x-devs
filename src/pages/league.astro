---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { getStakes, listStandings } from "@/lib/services/league";
import { cn } from "@/lib/utils";
import type { LeagueStakes, StandingsRow } from "@/types";

const isOrganizer = Astro.locals.role === "organizer";
const userId = Astro.locals.user?.id;
const error = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);

const { data: stakes, error: loadError }: { data: LeagueStakes | null; error: string | null } = supabase
  ? await getStakes(supabase)
  : { data: null, error: "Supabase is not configured" };
// Independent of the stakes read: either section can fail on its own.
const { data: standings, error: standingsError }: { data: StandingsRow[]; error: string | null } = supabase
  ? await listStandings(supabase)
  : { data: [], error: "Supabase is not configured" };

const bannerClass = "rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300";
const inputClass =
  "w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-blue-100/40 focus:border-purple-300 focus:outline-none";
---

<Layout title="Liga">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-2xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Liga
        </h1>

        {error && (
          <p class:list={cn(bannerClass, "mb-6")} role="alert">
            {error}
          </p>
        )}

        {loadError || !stakes ? (
          <p class:list={bannerClass} role="alert">
            {loadError ?? "Nie udało się wczytać stawek"}
          </p>
        ) : (
          <>
            <div
              data-testid="league-stakes"
              data-exact={stakes.exact_points}
              data-outcome={stakes.outcome_points}
              class="mb-6"
            >
              <h2 class="mb-2 text-lg font-semibold">Punktacja</h2>
              <ul class="list-disc space-y-1 pl-5 text-sm text-blue-100/80">
                <li>Dokładny wynik: {stakes.exact_points} pkt</li>
                <li>Trafiony zwycięzca albo remis przy innym wyniku: {stakes.outcome_points} pkt</li>
                <li>Błędny typ: 0 pkt</li>
              </ul>
            </div>

            {isOrganizer && (
              <form data-testid="stakes-form" method="POST" action="/api/league" class="grid gap-4 sm:grid-cols-2">
                <label class="flex flex-col gap-1 text-sm text-blue-100/80">
                  Dokładny wynik (pkt)
                  <input
                    type="number"
                    name="exact_points"
                    min="1"
                    max="99"
                    step="1"
                    required
                    value={stakes.exact_points}
                    class:list={inputClass}
                  />
                </label>
                <label class="flex flex-col gap-1 text-sm text-blue-100/80">
                  Trafiony zwycięzca albo remis (pkt)
                  <input
                    type="number"
                    name="outcome_points"
                    min="0"
                    max="99"
                    step="1"
                    required
                    value={stakes.outcome_points}
                    class:list={inputClass}
                  />
                </label>
                <div class="sm:col-span-2">
                  <button
                    type="submit"
                    class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
                  >
                    Zapisz stawki
                  </button>
                </div>
              </form>
            )}
          </>
        )}

        <section class="mt-8">
          <h2 class="mb-2 text-lg font-semibold">Klasyfikacja</h2>
          {standingsError ? (
            <p class:list={bannerClass} role="alert">
              {standingsError}
            </p>
          ) : standings.length === 0 ? (
            <p class="text-sm text-blue-100/60">Nikt jeszcze nie typował</p>
          ) : (
            <table data-testid="standings" class="w-full text-left text-sm">
              <thead class="text-blue-100/60">
                <tr class="border-b border-white/10">
                  <th scope="col" class="py-2 pr-2 font-medium">
                    Miejsce
                  </th>
                  <th scope="col" class="py-2 pr-2 font-medium">
                    Użytkownik
                  </th>
                  <th scope="col" class="py-2 pr-2 text-right font-medium">
                    Pkt
                  </th>
                  <th scope="col" class="py-2 text-right font-medium">
                    Dokładne
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/10">
                {standings.map((row) => {
                  const isMe = row.user_id === userId;
                  return (
                    <tr
                      data-user={row.display_name ?? ""}
                      data-rank={row.rank}
                      data-points={row.points}
                      data-exact={row.exact_count}
                      class:list={cn("text-blue-100/80", isMe && "font-semibold text-white")}
                    >
                      <td class="py-2 pr-2">{row.rank}</td>
                      <td class="py-2 pr-2 break-all">
                        {row.display_name ?? "Użytkownik"}
                        {isMe && " (Ty)"}
                      </td>
                      <td class="py-2 pr-2 text-right font-mono">{row.points}</td>
                      <td class="py-2 text-right font-mono">{row.exact_count}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          )}
          <p class="mt-3 text-xs text-blue-100/60">
            Przy równej liczbie punktów wyżej jest osoba z większą liczbą dokładnych wyników; przy pełnym remisie
            miejsce jest wspólne.
          </p>
        </section>
      </div>
    </div>
  </div>
</Layout>
