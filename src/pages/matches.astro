---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { listMatches } from "@/lib/services/matches";
import { listOwnTips } from "@/lib/services/tips";
import { MAX_SEARCH_LENGTH } from "@/lib/search";
import MatchesTable from "@/components/matches/MatchesTable";
import type { Match, Tip } from "@/types";

const { role, user } = Astro.locals;
const isOrganizer = role === "organizer";
const error = Astro.url.searchParams.get("error");
// Search and sort live in the URL, so the server already renders the filtered, sorted table.
const initialQuery = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, MAX_SEARCH_LENGTH);
const initialSort = Astro.url.searchParams.get("sort") === "desc" ? "desc" : "asc";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { data: matches, error: loadError } = supabase
  ? await listMatches(supabase)
  : { data: [] as Match[], error: null };
// A failed tips query shows a banner; the match list still renders.
const { data: ownTips, error: tipsError } =
  supabase && user ? await listOwnTips(supabase, user.id) : { data: [] as Tip[], error: null };
---

<Layout title="Mecze">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-3xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Mecze
        </h1>

        {error && (
          <p class="mb-6 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300" role="alert">
            {error}
          </p>
        )}

        <MatchesTable
          client:load
          matches={matches}
          loadError={loadError}
          tips={ownTips}
          tipsError={tipsError}
          isOrganizer={isOrganizer}
          now={Date.now()}
          initialQuery={initialQuery}
          initialSort={initialSort}
        />
      </div>
    </div>
  </div>
</Layout>
