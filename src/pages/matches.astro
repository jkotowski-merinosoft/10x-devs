---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { listMatches } from "@/lib/services/matches";
import { listOwnTips } from "@/lib/services/tips";
import { formatWarsaw } from "@/lib/time";
import { cn } from "@/lib/utils";
import type { Match, Tip } from "@/types";

const { role, user } = Astro.locals;
const isOrganizer = role === "organizer";
const error = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { data: matches, error: loadError } = supabase
  ? await listMatches(supabase)
  : { data: [] as Match[], error: null };
// A failed tips query shows a banner; the match list still renders.
const { data: ownTips, error: tipsError } =
  supabase && user ? await listOwnTips(supabase, user.id) : { data: [] as Tip[], error: null };
const tipByMatch = new Map(ownTips.map((tip) => [tip.match_id, tip]));
const now = Date.now();

const inputClass =
  "w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-blue-100/40 focus:border-purple-300 focus:outline-none";
---

<Layout title="Mecze">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-2xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Mecze
        </h1>

        {error && (
          <p class="mb-6 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300" role="alert">
            {error}
          </p>
        )}

        {isOrganizer && (
          <form method="POST" action="/api/matches" class="mb-8 grid gap-4 sm:grid-cols-2">
            <label class="flex flex-col gap-1 text-sm text-blue-100/80">
              Strona A
              <input type="text" name="side_a" required maxlength="100" class:list={inputClass} />
            </label>
            <label class="flex flex-col gap-1 text-sm text-blue-100/80">
              Strona B
              <input type="text" name="side_b" required maxlength="100" class:list={inputClass} />
            </label>
            <label class="flex flex-col gap-1 text-sm text-blue-100/80 sm:col-span-2">
              Rozpoczęcie (czas warszawski)
              <input
                type="datetime-local"
                name="starts_at"
                required
                class:list={cn(inputClass, "[color-scheme:dark]")}
              />
            </label>
            <div class="sm:col-span-2">
              <button
                type="submit"
                class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
              >
                Dodaj mecz
              </button>
            </div>
          </form>
        )}

        {tipsError && (
          <p class="mb-6 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300" role="alert">
            {tipsError}
          </p>
        )}

        {loadError ? (
          <p class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300" role="alert">
            {loadError}
          </p>
        ) : matches.length === 0 ? (
          <p class="text-blue-100/60">Brak meczów</p>
        ) : (
          <ul class="divide-y divide-white/10">
            {matches.map((match) => {
              const tip = tipByMatch.get(match.id);
              const isOpen = now < new Date(match.starts_at).getTime();
              return (
                <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-3">
                  <a
                    href={`/matches/${match.id}`}
                    class="font-semibold text-white transition-colors hover:text-purple-200 hover:underline"
                  >
                    {match.side_a} – {match.side_b}
                  </a>
                  <span class="flex shrink-0 items-center gap-3 text-sm text-blue-100/70">
                    <span>{formatWarsaw(match.starts_at)}</span>
                    {!tipsError && <span>{tip ? `Twój typ: ${tip.score_a}:${tip.score_b}` : "brak typu"}</span>}
                    <span
                      class:list={cn(
                        "rounded-full border px-2 py-0.5 text-xs",
                        isOpen ? "border-green-400/40 text-green-300" : "border-white/20 text-blue-100/50",
                      )}
                    >
                      {isOpen ? "otwarte" : "zamknięte"}
                    </span>
                  </span>
                </li>
              );
            })}
          </ul>
        )}
      </div>
    </div>
  </div>
</Layout>
